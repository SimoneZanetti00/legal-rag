# Copy to .env and adjust. Never commit .env or real API keys.
# Every variable is optional; the values below are the defaults.

# Paths (relative paths are resolved against the project root)
DATA_DIR=data
INDEX_DIR=data/indexes

# Models
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# LLM provider: mock | anthropic | openai (openai is not implemented yet)
# "mock" sends nothing to external services. Only choose a real provider if
# you are allowed to send your documents to it.
LLM_PROVIDER=mock
# Required for a real provider. For anthropic, a Claude model ID such as claude-opus-5-5.
LLM_MODEL=
# Put real keys only in .env (git-ignored), never here.
# ANTHROPIC_API_KEY is used only for LLM_PROVIDER=anthropic: an API key from the
# Claude Console (https://platform.claude.com/settings/keys). API usage is billed
# to that account; a Claude subscription does not by itself provide API access.
ANTHROPIC_API_KEY=
# LLM_API_KEY is for other providers (none implemented yet); anthropic ignores it.
LLM_API_KEY=
# Seconds to wait for one request attempt. Requests are never retried for
# provider errors; at most MAX_GENERATION_RETRIES more are sent for an invalid
# reply, so one call waits about (1 + MAX_GENERATION_RETRIES) x this at most.
LLM_TIMEOUT_SECONDS=120
# anthropic, opt-in: false (default) means a refusal is an error and no other
# model is tried. true lets the API re-run a declined request on Anthropic's
# recommended fallback model, a different model; the model that actually
# answered is then recorded in the provenance (served_by, fallback_used).
LLM_REFUSAL_FALLBACK=false

# Retrieval and evidence selection
BM25_TOP_K=20
DENSE_TOP_K=20
RERANK_TOP_K=20
FINAL_EVIDENCE_COUNT=5
RRF_K=60
CONTEXT_TOKEN_BUDGET=3000

# Chunking (characters)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Thresholds (leave empty to disable)
MIN_RETRIEVAL_SCORE=
MIN_RERANK_SCORE=

# Sources without effective dates under an "as of" filter: warn | exclude
UNDATED_SOURCE_POLICY=warn

# Retries for malformed LLM output (0 or 1)
MAX_GENERATION_RETRIES=1
