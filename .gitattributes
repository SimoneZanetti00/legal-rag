# Reference inventories and their reports (P1.2): LF in the repository and in every
# checkout, whatever core.autocrlf says, so the SHA-256 values recorded for them
# hold on every platform.
data/reference/*.json text eol=lf
data/reference/*.md text eol=lf
# Corpus build specifications (P1.3): their SHA-256 is recorded in every build record.
data/corpus_specs/*.json text eol=lf
# Official sources archived for M1: stored and checked out byte for byte, with no
# line-ending conversion, so their recorded SHA-256 holds in every checkout.
data/raw/trial-2026-10-10/official-sources/*.html -text
data/raw/trial-2026-10-10/official-sources/*.pdf binary
# Benchmarks (M4): tests/test_legal_benchmarks.py pins the SHA-256 of their files, and their
# READMEs quote those values, so they stay LF in every checkout. The folder holds no binary file.
data/evaluation/** text eol=lf
# The generated M1 review package: `python -m tools.review_package.generate --check` compares it
# byte for byte, and the review record quotes its SHA-256.
docs/reviews/m1-human-review-package.md text eol=lf
# legal-v1 was frozen with CRLF data files; these keep its pinned SHA-256 values in every checkout.
data/evaluation/legal-v1/benchmark.json text eol=crlf
data/evaluation/legal-v1/judgments.jsonl text eol=crlf
data/evaluation/legal-v1/pool.jsonl text eol=crlf
data/evaluation/legal-v1/questions.jsonl text eol=crlf
# The live Space's Dockerfile keeps LF line endings on every checkout: a CR after a line
# continuation would break the build.
deploy/live-space/Dockerfile text eol=lf
